# Everything is optional. With no keys the app runs on offline stand-ins for PayPal and Claude.

# Server
PORT=3002
# Public https address when hosted (used in the start log and for webhook registration). Empty = http://localhost:PORT
PUBLIC_URL=
# Reverse proxy hops to trust for X-Forwarded-* (default loopback: a proxy on the same machine)
# TRUST_PROXY=loopback

# Claude (Anthropic API). Without a key an offline stand-in answers with the same message shape.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Development only: LLM_BACKEND=account runs Claude through your local Claude Code login (Claude Agent SDK) instead of an API key.
# The API key variables are removed from the Claude Code process. Leave unset for the offline stand-in or the API.
# LLM_BACKEND=account
# STREAM_MODEL=0 sends whole answers instead of streaming (adapter fallback level 1)

# PayPal sandbox app (REST app of a sandbox business account with the disputes scopes)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Sandbox buyer, only for scripts/sandbox-filing (creates test disputes through the buyer web UI)
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=

# Build-time fallback: 2 = dispute-analyst alone, without Studio's built-in agents
# VITE_ADAPTER_LEVEL=0

# AG Studio trial licence key (removes the watermark). It is a front-end key, so it ends up in the built page.
VITE_AG_STUDIO_LICENSE=

# Offline stand-in: the observed sandbox durations (minutes) run this many times faster
MOCK_TIME_SCALE=40

# Sandbox demo mode (needs the PayPal keys above): real sandbox disputes (SNAD, USD 66.12, Wool Blanket) play case A, one per
# session, first open one wins; B and C stay on the stand-in. File each with `npm run case-a:new` (about 6 minutes),
# list the printed ids comma-separated here, then `npm run demo:sandbox`. README "Sandbox demo mode".
SANDBOX_CASE_A=

# Judge paths: refill worker and reserved stock (sandbox mode only)
POOL_ENABLED=0
POOL_TARGET=6
STATE_FILE=

# Demo limits
CHAT_PER_IP_HOUR=40
CHAT_PER_DAY=300
WRITES_PER_HOUR=30

# Live Claude protection (one run = one user action). Over a cap or on an API error the recorded run / rule-based stand-in answers.
LLM_LIVE_PER_IP_HOUR=10
LLM_LIVE_PER_DAY=150
# LLM_TIMEOUT_MS=60000
